<div class="query-group @(Group.Operator == GroupOperator.And ? "op-and" : "op-or")">
    <div class="query-group-header">
        <span class="match-label">Match</span>

        <div class="btn-group btn-group-sm" role="group" aria-label="Match all or any">
            <button type="button" class="btn @(Group.Operator == GroupOperator.And ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => Group.Operator = GroupOperator.And">
                ALL
            </button>
            <button type="button" class="btn @(Group.Operator == GroupOperator.Or ? "btn-warning" : "btn-outline-warning")"
                    @onclick="() => Group.Operator = GroupOperator.Or">
                ANY
            </button>
        </div>

        <span class="match-label">of the following:</span>

        <label class="exclude-toggle">
            <input type="checkbox" @bind="Group.Negate" />
            Exclude these matches
        </label>

        <span class="spacer"></span>

        @if (!IsRoot)
        {
            <button type="button" class="btn btn-sm btn-outline-danger icon-btn" title="Remove this group" @onclick="OnRemove">
                &#x2715; Remove group
            </button>
        }
    </div>

    <div class="query-group-children">
        @foreach (var child in Group.Children.ToList())
        {
            @if (child is ConditionEditor condition)
            {
                <QueryConditionRow Condition="condition" ParentGroup="Group" OnRemove="() => RemoveChild(child)" />
            }
            else if (child is GroupEditor group)
            {
                <QueryGroupEditor Group="group" OnRemove="() => RemoveChild(child)" />
            }
        }
    </div>

    @if (Group.Children.Count == 0)
    {
        <p class="query-empty-hint">No conditions yet - add one below to start narrowing down your logs.</p>
    }

    <div class="query-group-actions">
        <button type="button" class="btn btn-sm btn-primary" @onclick="AddCondition">+ Add condition</button>
        <button type="button" class="btn btn-sm btn-link text-muted" @onclick="AddGroup">
            + Add a nested group (advanced)
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GroupEditor Group { get; set; } = null!;
    [Parameter] public bool IsRoot { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private void AddCondition() => Group.Children.Add(new ConditionEditor());
    private void AddGroup() => Group.Children.Add(new GroupEditor());
    private void RemoveChild(QueryNodeEditor child) => Group.Children.Remove(child);
}
