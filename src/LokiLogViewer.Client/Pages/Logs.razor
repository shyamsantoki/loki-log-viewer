@page "/logs"
@* Prerendering runs on the server, which doesn't have LogApiClient registered (only the
   Client's WASM DI container does) - this page is interactive-only anyway, so skip it. *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject LogApiClient Api

<PageTitle>Logs</PageTitle>

<div class="logs-page">
    <h1>Logs</h1>

    <QueryGroupEditor Group="_root" IsRoot="true" />

    <div class="query-toolbar">
        <div class="field">
            <label>Time range</label>
            <select class="form-select form-select-sm" @bind="_selectedRangeMinutes">
                <option value="15">Last 15 minutes</option>
                <option value="60">Last 1 hour</option>
                <option value="360">Last 6 hours</option>
                <option value="1440">Last 24 hours</option>
            </select>
        </div>

        <div class="field">
            <label>Limit per page</label>
            <input type="number" class="form-control form-control-sm" min="1" max="1000" style="width: 6rem" @bind="_limit" />
        </div>

        <span class="spacer" style="flex:1"></span>

        <button type="button" class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-inline"></span>
            }
            Run
        </button>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_entries.Count > 0)
    {
        <div class="results-summary">
            <strong>@_entries.Count</strong> log line@(_entries.Count == 1 ? "" : "s")
        </div>

        <table class="log-results table table-sm table-hover">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Labels</th>
                    <th>Line</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td class="log-timestamp">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                        <td>
                            @foreach (var (key, value) in entry.Labels)
                            {
                                <span class="label-badge @(IsLevelKey(key) ? $"level-badge {LevelClass(value)}" : "")">@key=@value</span>
                            }
                        </td>
                        <td class="log-line">@entry.Line</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_cursor is not null)
        {
            <div class="load-more-row">
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadMoreAsync" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-inline"></span>
                    }
                    Load more
                </button>
            </div>
        }
    }
    else if (_hasSearched && !_loading && _error is null)
    {
        <p class="text-muted">No log lines matched.</p>
    }
</div>

@code {
    private readonly GroupEditor _root = new();
    private readonly List<LogEntry> _entries = [];
    private long? _cursor;
    private bool _loading;
    private bool _hasSearched;
    private string? _error;
    private int _selectedRangeMinutes = 60;
    private int _limit = 200;

    private Task RunAsync()
    {
        _entries.Clear();
        _cursor = null;
        _hasSearched = true;
        return FetchPageAsync(cursor: null);
    }

    private Task LoadMoreAsync() => FetchPageAsync(_cursor);

    private async Task FetchPageAsync(long? cursor)
    {
        _loading = true;
        _error = null;
        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = to.AddMinutes(-_selectedRangeMinutes);
            var request = new LogQueryRequest(_root.ToQueryNode(), from, to, _limit, cursor);
            var response = await Api.QueryAsync(request, CancellationToken.None);
            _entries.AddRange(response.Entries);
            _cursor = response.NextCursor;
        }
        catch (LogApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsLevelKey(string key) =>
        key.Equals("level", StringComparison.OrdinalIgnoreCase) ||
        key.Equals("detected_level", StringComparison.OrdinalIgnoreCase);

    private static string LevelClass(string level) => $"level-{level.ToLowerInvariant()}";
}
