@page "/"
@* Prerendering runs on the server, which doesn't have LogApiClient registered (only the
   Client's WASM DI container does) - this page is interactive-only anyway, so skip it. *@
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using LokiLogViewer.Client.Results
@inject LogApiClient Api

<PageTitle>LokiLogViewer</PageTitle>

<div class="logs-layout">
    <FieldsSidebar AvailableLabels="_availableLabelKeys" SelectedLabels="_selectedLabelKeys" OnToggleLabel="ToggleLabel"
                    AvailableFields="_availableFieldPaths" SelectedFields="_selectedFieldPaths" OnToggleField="ToggleField" />

    <div class="logs-main">
        <h1>Search your logs</h1>
        <p class="page-subtitle">Fill in what you know, pick a time range, then click Search.</p>

        <div class="search-fields">
            @foreach (var field in _searchFields)
            {
                <SearchFieldRow Definition="field" Value="@_fieldValues.GetValueOrDefault(field.Label, "")"
                                 OnValueChanged="value => SetFieldValue(field.Label, value)"
                                 OtherValues="GetOtherValues(field.Label)" />
            }
        </div>

        <div class="additional-filters">
            @if (_adHocFilters.Count > 0)
            {
                <label class="additional-filters-label">Additional filters</label>
                @foreach (var filter in _adHocFilters)
                {
                    <AdHocFilterRow Label="@filter.Label" OnLabelChanged="value => filter.Label = value"
                                     Value="@filter.Value" OnValueChanged="value => filter.Value = value"
                                     OnRemove="() => _adHocFilters.Remove(filter)"
                                     OtherValues="GetOtherValues(filter.Label)" />
                }
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddAdHocFilter">+ Add filter</button>
        </div>

        <div class="query-toolbar">
            <div class="field">
                <label>Time range</label>
                <select class="form-select form-select-sm" @bind="_selectedRangeMinutes">
                    <option value="15">Last 15 minutes</option>
                    <option value="60">Last 1 hour</option>
                    <option value="360">Last 6 hours</option>
                    <option value="1440">Last 24 hours</option>
                </select>
            </div>

            <div class="field">
                <label>Max results per page</label>
                <input type="number" class="form-control form-control-sm" min="1" max="1000" style="width: 6rem" @bind="_limit" />
            </div>

            <span class="spacer" style="flex:1"></span>

            <button type="button" class="btn btn-primary btn-lg" @onclick="RunAsync" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-inline"></span>
                }
                Search logs
            </button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (_entries.Count > 0)
        {
            <div class="results-summary">
                Showing <strong>@_entries.Count</strong> log line@(_entries.Count == 1 ? "" : "s")
            </div>

            <table class="log-results table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Time</th>
                        @foreach (var label in _selectedLabelKeys)
                        {
                            <th>@label</th>
                        }
                        @foreach (var field in _selectedFieldPaths)
                        {
                            <th>@field</th>
                        }
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        <tr>
                            <td class="log-timestamp">@entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            @foreach (var label in _selectedLabelKeys)
                            {
                                <td class="log-field-cell">@(entry.Labels.GetValueOrDefault(label))</td>
                            }
                            @foreach (var field in _selectedFieldPaths)
                            {
                                <td class="log-field-cell">@GetFieldValue(entry, field)</td>
                            }
                            <td class="log-line">
                                @if (GetLevel(entry) is { } level)
                                {
                                    <span class="label-badge level-badge @LevelClass(level)">@level</span>
                                }
                                @entry.Line
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_cursor is not null)
            {
                <div class="load-more-row">
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadMoreAsync" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="spinner-inline"></span>
                        }
                        Load more logs
                    </button>
                </div>
            }
        }
        else if (_hasSearched && !_loading && _error is null)
        {
            <p class="text-muted">No log lines matched. Try widening the time range or clearing a filter.</p>
        }
    </div>
</div>

@code {
    private sealed class AdHocFilter
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private IReadOnlyList<SearchFieldDefinition> _searchFields = [];
    private readonly Dictionary<string, string> _fieldValues = [];
    private readonly List<AdHocFilter> _adHocFilters = [];

    private readonly List<LogEntry> _entries = [];
    private long? _cursor;
    private bool _loading;
    private bool _hasSearched;
    private string? _error;
    private int _selectedRangeMinutes = 60;
    private int _limit = 200;

    private List<string> _availableLabelKeys = [];
    private readonly HashSet<string> _selectedLabelKeys = [];
    private List<string> _availableFieldPaths = [];
    private readonly HashSet<string> _selectedFieldPaths = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _searchFields = await Api.GetSearchFieldsAsync(CancellationToken.None);
        }
        catch (LogApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void SetFieldValue(string label, string value) => _fieldValues[label] = value;

    private void AddAdHocFilter() => _adHocFilters.Add(new AdHocFilter());

    // Every other filter (fixed fields + ad-hoc rows) that currently has a label and a value,
    // excluding whichever one is asking (so a field never scopes its own suggestions by itself).
    private IReadOnlyDictionary<string, string> GetOtherValues(string excludingLabel)
    {
        var result = new Dictionary<string, string>();
        foreach (var (label, value) in _fieldValues)
        {
            if (label != excludingLabel && !string.IsNullOrWhiteSpace(value))
            {
                result[label] = value;
            }
        }

        foreach (var filter in _adHocFilters)
        {
            if (!string.IsNullOrWhiteSpace(filter.Label) && filter.Label != excludingLabel && !string.IsNullOrWhiteSpace(filter.Value))
            {
                result[filter.Label] = filter.Value;
            }
        }

        return result;
    }

    private Task RunAsync()
    {
        var conditions = BuildConditions();
        if (conditions.Count == 0)
        {
            _error = "Fill in at least one filter above, then search again.";
            return Task.CompletedTask;
        }

        _entries.Clear();
        _cursor = null;
        _hasSearched = true;
        return FetchPageAsync(conditions, cursor: null);
    }

    // The 4 configured fields and any ad-hoc rows are just two sources of the same thing - a
    // label/value pair - so they're merged into one list here. A later source overriding an
    // earlier one with the same label (last-write-wins) avoids ever sending Loki a selector that
    // contradicts itself, e.g. {namespace="a", namespace="b"}, if someone adds an ad-hoc filter
    // for a label a fixed field already covers.
    private List<LogCondition> BuildConditions()
    {
        var merged = new Dictionary<string, string>();
        foreach (var (label, value) in _fieldValues)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                merged[label] = value;
            }
        }

        foreach (var filter in _adHocFilters)
        {
            if (!string.IsNullOrWhiteSpace(filter.Label) && !string.IsNullOrWhiteSpace(filter.Value))
            {
                merged[filter.Label] = filter.Value;
            }
        }

        return merged.Select(kv => new LogCondition(kv.Key, kv.Value)).ToList();
    }

    private Task LoadMoreAsync() => FetchPageAsync(BuildConditions(), _cursor);

    private async Task FetchPageAsync(List<LogCondition> conditions, long? cursor)
    {
        _loading = true;
        _error = null;
        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = to.AddMinutes(-_selectedRangeMinutes);
            var request = new LogQueryRequest(conditions, from, to, _limit, cursor);
            var response = await Api.QueryAsync(request, CancellationToken.None);
            _entries.AddRange(response.Entries);
            _cursor = response.NextCursor;
            RecomputeAvailableColumns();
        }
        catch (LogApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Labels/fields are discovered from whatever's already loaded, not a dedicated sample
    // query - simplest option, at the cost of the list only growing as more pages load.
    private void RecomputeAvailableColumns()
    {
        var labelKeys = new SortedSet<string>(StringComparer.Ordinal);
        var fieldPaths = new SortedSet<string>(StringComparer.Ordinal);

        foreach (var entry in _entries)
        {
            foreach (var key in entry.Labels.Keys)
            {
                labelKeys.Add(key);
            }

            foreach (var key in LogLineJson.Flatten(entry.Line).Keys)
            {
                fieldPaths.Add(key);
            }
        }

        _availableLabelKeys = labelKeys.ToList();
        _availableFieldPaths = fieldPaths.ToList();
        _selectedLabelKeys.IntersectWith(labelKeys);
        _selectedFieldPaths.IntersectWith(fieldPaths);
    }

    private void ToggleLabel(string key)
    {
        if (!_selectedLabelKeys.Remove(key))
        {
            _selectedLabelKeys.Add(key);
        }
    }

    private void ToggleField(string path)
    {
        if (!_selectedFieldPaths.Remove(path))
        {
            _selectedFieldPaths.Add(path);
        }
    }

    private static string? GetFieldValue(LogEntry entry, string path) =>
        LogLineJson.Flatten(entry.Line).GetValueOrDefault(path);

    private static string? GetLevel(LogEntry entry) =>
        entry.Labels.GetValueOrDefault("level") ?? entry.Labels.GetValueOrDefault("detected_level");

    private static string LevelClass(string level) => $"level-{level.ToLowerInvariant()}";
}
